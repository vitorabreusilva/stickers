# Copy to .env.local for local development. On Vercel, set these in Project → Settings → Environment Variables.

# Postgres. Locally: the Docker database from docker-compose.yml. On Vercel: Neon's pooled connection string.
DATABASE_URL=postgres://stickers:stickers@localhost:5433/stickers

# Signs sessions. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# The address the app is served from. Google redirects back here after sign-in.
BETTER_AUTH_URL=http://localhost:5173

# Google OAuth client (Google Cloud Console → APIs & Services → Credentials → OAuth client ID, "Web application").
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Who may sign in: comma-separated Google emails, or * for anyone. Empty lets no one in.
ALLOWED_EMAILS=

# Vercel Blob (private store). Set automatically when a Blob store is connected to the Vercel project.
# Leave unset locally to keep pictures in .data/images/.
# BLOB_READ_WRITE_TOKEN=

# AI drawing for coloring pages, with the app's own accounts. Each one is optional: signed-in people can
# draw with every provider that has a key here, and need their own key (saved on their device) for the rest.
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# FAL_KEY=
# QUIVER_API_KEY=
